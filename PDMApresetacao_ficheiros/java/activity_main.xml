<?xml version="1.0" encoding="utf-8"?>
<!-- Raiz: o id "main" é usado para aplicar as margens das barras do sistema -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Texto de exemplo: o tamanho é alterado pelo botão "Tamanho do texto" -->
    <TextView
        android:id="@+id/txtExemplo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/texto_exemplo" />

    <!-- Contentor dos botões (grelha): o número de colunas é alterado no código (1 = vertical, 2 = horizontal) -->
    <GridLayout
        android:id="@+id/contentorBotoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="1">

        <Button
            android:id="@+id/btnTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_tema" />

        <Button
            android:id="@+id/btnTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_texto" />

        <Button
            android:id="@+id/btnLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_layout" />

        <Button
            android:id="@+id/btnGrandes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grandes" />
    </GridLayout>

</LinearLayout>
