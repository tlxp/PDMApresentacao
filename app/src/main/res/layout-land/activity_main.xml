<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"

    tools:context=".MainActivity">

    <!-- Texto -->
    <TextView
        android:id="@+id/txtExemplo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/texto_exemplo"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo para escrever o nome -->
    <EditText
        android:id="@+id/campoNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Escreve aqui"
        android:inputType="textPersonName"
        android:minHeight="48dp"

        app:layout_constraintTop_toBottomOf="@id/txtExemplo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contentor dos botões -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentorBotoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/campoNome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Modo claro / escuro -->
        <Button
            android:id="@+id/btnTema"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:minHeight="48dp"
            android:text="@string/btn_tema"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnTexto"
            android:layout_marginEnd="4dp" />

        <!-- Tamanho do texto -->
        <Button
            android:id="@+id/btnTexto"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:minHeight="48dp"
            android:text="@string/btn_texto"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnTema"
            app:layout_constraintEnd_toStartOf="@id/btnLayout"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Layout vertical / horizontal -->
        <Button
            android:id="@+id/btnLayout"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:minHeight="48dp"
            android:text="@string/btn_layout"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnTexto"
            app:layout_constraintEnd_toStartOf="@id/btnGrandes"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Botões maiores -->
        <Button
            android:id="@+id/btnGrandes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:minHeight="48dp"
            android:text="@string/btn_grandes"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnLayout"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>